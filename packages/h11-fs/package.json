{
  "name": "h11-fs",
  "version": "1.0.3",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "types": "dist/types/h11-fs.d.ts",
  "main": "dist/h11-fs.js",
  "exports": {
    ".": {
      "types": "./dist/types/h11-fs.d.ts",
      "default": "./dist/h11-fs.js"
    },
    "./bun": {
      "types": "./dist/types/providers/bun/fsapi.d.ts",
      "default": "./dist/providers/bun/fsapi.js"
    },
    "./node": {
      "types": "./dist/types/providers/node/fsapi.d.ts",
      "default": "./dist/providers/node/fsapi.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/h11-fs.ts ./src/providers/bun/fsapi.ts ./src/providers/node/fsapi.ts --target node --external bun --external h11 --outdir ./dist",
    "types": "tsc --project tsconfig.types.json"
  },
  "dependencies": {
    "h11": "*"
  }
}
