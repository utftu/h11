{
  "name": "h11x",
  "dependencies": {
    "h11-fs": "*",
    "regan": "^0.0.5",
    "regan-vite": "^1.0.1",
    "strangelove": "^2.1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/types/h11-x.d.ts",
