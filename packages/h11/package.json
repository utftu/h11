{
  "name": "h11",
  "version": "1.0.21",
  "description": "Minimal HTTP framework for Bun: a radix router with middlewares, static file serving and websockets",
  "license": "MIT",
  "author": "Aleksey Malyuta <overby999@gmail.com> (https://github.com/utftu)",
  "type": "module",
  "homepage": "https://github.com/utftu/h11/tree/master/packages/h11#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utftu/h11.git",
    "directory": "packages/h11"
  },
  "bugs": {
    "url": "https://github.com/utftu/h11/issues"
  },
  "keywords": [
    "http",
    "server",
    "framework",
    "router",
    "radix",
    "middleware",
    "static",
    "websocket",
    "bun"
  ],
  "types": "dist/types/h11.d.ts",
  "main": "dist/h11.js",
  "exports": {
    ".": {
      "types": "./dist/types/h11.d.ts",
      "default": "./dist/h11.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/h11.ts --target bun --packages external --outdir ./dist",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "dependencies": {
    "utftu": "^1.0.33"
  }
}