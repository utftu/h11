{
  "name": "h11-x",
  "version": "0.0.22",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utftu/h11.git",
    "directory": "packages/h11-x"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/h11-x.ts --target bun --packages external --outdir ./dist && bun build ./src/h11-x.client.ts --target browser --packages external --outdir ./dist",
    "build:types": "tsc --project tsconfig.types.json"
  },
  "exports": {
    ".": {
      "types": "./dist/types/h11-x.d.ts",
      "default": "./dist/h11-x.js"
    },
    "./client": {
      "types": "./dist/types/h11-x.client.d.ts",
      "default": "./dist/h11-x.client.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "defu": "^6.1.4",
    "h11": "*",
    "regan": "^0.0.16",
    "regan-vite": "^1.0.1",
    "vite": ">=7"
  }
}