{
  "name": "h11",
  "type": "module",
  "version": "0.0.4",
  "scripts": {
    "build": "bun run ./build.ts"
  },
  "files": [
    "./dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/h11.d.ts",
      "default": "./dist/h11.js"
    },
    "./bun": {
      "types": "./dist/types/providers/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./node": {
      "types": "./dist/types/providers/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "mitata": "^0.1.14",
    "regan-vite": "^1.0.1",
    "serve-static": "^2.2.0",
    "strangelove": "^2.1.4",
    "typescript": "^5.0.0",
    "utftu": "1.0.33",
    "vite": "^7.1.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@types/serve-static": "^1.15.8",
    "dapes": "^0.0.40",
    "esbuild": "^0.25.11",
    "express": "^5.1.0",
    "logw": "^0.0.2",
    "regan": "^0.0.12",
    "vitest": "^3.2.4"
  }
}
